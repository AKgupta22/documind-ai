# Copy this file to apps/api/.env and adjust for your environment.
# Never commit the resulting .env file.

# PostgreSQL connection string. Must match the credentials in the root .env
# used by docker-compose.yml.
DATABASE_URL=postgresql://documind:change-me-local-only@localhost:5432/documind?schema=public

# JWT signing secret. Use a long random value and a different value per environment.
JWT_SALT=replace-with-a-long-random-secret

# Auth cookie settings. Tokens are httpOnly cookies; never expose them to JS.
# COOKIE_DOMAIN: optional. Leave empty for a host-only cookie (localhost).
#   Use a shared parent domain (for example .documind.example) when the web and
#   API run on different subdomains of the same site.
# COOKIE_SECURE: defaults to true when NODE_ENV=production.
# COOKIE_SAME_SITE: lax (default), strict, or none. Use none only for cross-site
#   deployments; it forces Secure cookies, which requires HTTPS.
# COOKIE_DOMAIN=
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax

# HTTP port for the Express API.
PORT=3001

# Comma-separated list of allowed browser origins (the Next.js app).
# Credentials (cookies) are enabled, so every origin must be listed exactly.
WEB_ORIGIN=http://localhost:3000

NODE_ENV=development
