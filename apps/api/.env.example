# Copy this file to apps/api/.env and adjust for your environment.
# Never commit the resulting .env file.

# PostgreSQL connection string. Must match the credentials in the root .env
# used by docker-compose.yml.
DATABASE_URL=postgresql://documind:change-me-local-only@localhost:5432/documind?schema=public

# JWT Salt key

JWT_SALT=your salt key

# HTTP port for the Express API.
PORT=3001

# Comma-separated list of allowed browser origins (the Next.js app).
WEB_ORIGIN=http://localhost:3000

NODE_ENV=development
