# Used by docker-compose.yml to provision the local PostgreSQL instance.
# Copy this file to .env before running `docker compose up -d`.
# These are local development values only. Never reuse them outside local development.

POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=documind
POSTGRES_PORT=5432

# Host port for the local Redis cache container.
REDIS_PORT=6379
